.build/
.swiftpm/
dist/
.DS_Store
.qwen/
.claude/

# Generated icon intermediates (Resources/AppIcon.icns IS committed —
# it is a build input for the .app bundle).
*.iconset/

# Internal roadmap / decisions log — local only.
PLAN.md

# Agent instructions — local only, and never part of a release: they are rules
# for whoever is working on the checkout, not something the app ships with.
AGENTS.md
CLAUDE.md

# Feature briefs — local only.
PRD-*.md

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Local tool config — editor, MCP and search settings, not project files.
/.ignore
/.mcp.json
/opencode.json
